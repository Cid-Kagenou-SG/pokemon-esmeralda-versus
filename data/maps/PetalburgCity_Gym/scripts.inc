	setmetatile 7, 7, METATILE_PetalburgGym_RoomEntrance_Right, FALSE
	return

PetalburgCity_Gym_EventScript_SlideOpenRoomDoors::
	special PetalburgGymSlideOpenRoomDoors
	return

PetalburgCity_Gym_EventScript_UnlockRoomDoors::
	special PetalburgGymUnlockRoomDoors
	return

PetalburgCity_Gym_EventScript_GymGuide::
	lock
	faceplayer
	goto_if_set FLAG_DEFEATED_PETALBURG_GYM, PetalburgCity_Gym_EventScript_GymGuidePostVictory
	msgbox PetalburgCity_Gym_Text_GymGuideAdvice, MSGBOX_DEFAULT
	release
	end

PetalburgCity_Gym_EventScript_GymGuidePostVictory::
	msgbox PetalburgCity_Gym_Text_GymGuidePostVictory, MSGBOX_DEFAULT
	release
	end

PetalburgCity_Gym_EventScript_LeftGymStatue::
	lockall
	goto_if_set FLAG_BADGE05_GET, PetalburgCity_Gym_EventScript_GymStatueCertified
	goto PetalburgCity_Gym_EventScript_GymStatue
	end

PetalburgCity_Gym_EventScript_RightGymStatue::
	lockall
	goto_if_set FLAG_BADGE05_GET, PetalburgCity_Gym_EventScript_GymStatueCertified
	goto PetalburgCity_Gym_EventScript_GymStatue
	end

PetalburgCity_Gym_EventScript_GymStatueCertified::
	msgbox PetalburgCity_Gym_Text_GymStatueCertified, MSGBOX_DEFAULT
	releaseall
	end

PetalburgCity_Gym_EventScript_GymStatue::
	msgbox PetalburgCity_Gym_Text_GymStatue, MSGBOX_DEFAULT
	releaseall
	end

PetalburgCity_Gym_Text_DadYoureHereWithYourPokemon:
	.string "PAPÁ: ¿Mmm?\p"
	.string "¡Pero si es {PLAYER}!\n"
	.string "¿Ya has terminado de instalarte?\p"
	.string "Me sorprende que hayas llegado\n"
	.string "hasta aquí tú solo.\p"
	.string "Ah, ya veo.\n"
	.string "Vienes con tu Pokémon.\p"
	.string "Mmm... Entonces supongo que tú también\n"
	.string "vas a ser entrenador, {PLAYER}.\p"
	.string "¡Eso es estupendo!\n"
	.string "¡Lo esperaré con impaciencia!$"

PetalburgCity_Gym_Text_WallyIdLikeAPokemon:
	.string "Mmm... Yo...\n"
	.string "Quisiera tener un Pokémon, por favor...$"

PetalburgCity_Gym_Text_DadOhYoureWallyRight:
	.string "PAPÁ: ¿Mmm? Eres... Eh... Ah, sí.\n"
	.string "Eres Blasco, ¿verdad?$"

PetalburgCity_Gym_Text_WallyIveNeverCaughtAPokemon:
	.string "BLASCO: Voy a ir a casa de mis\n"
	.string "familiares a Pueblo Verdegal.\p"
	.string "Pensé que me sentiría solo si iba\n"
	.string "solo, así que quería llevarme un Pokémon.\p"
	.string "Pero nunca he atrapado uno.\n"
	.string "No sé cómo...$"

PetalburgCity_Gym_Text_DadHmISee:
	.string "PAPÁ: Mmm. Ya veo.$"

PetalburgCity_Gym_Text_DadPlayerGoWithWally:
	.string "PAPÁ: {PLAYER}, has oído lo que ha\n"
	.string "dicho, ¿verdad?\p"
	.string "Acompaña a Blasco y asegúrate de que\n"
	.string "atrapa un Pokémon sin problemas.$"

PetalburgCity_Gym_Text_IllLoanYouMyZigzagoon:
	.string "BLASCO, toma. Te prestaré mi Pokémon.\p"
	.string "¡Blasco ha recibido un Zigzagoon!$"

PetalburgCity_Gym_Text_WallyThankYouAndDadGivesPokeBall:
	.string "BLASCO: ¡Oh, guau!\n"
	.string "¡Un Pokémon!\p"
	.string "PAPÁ: Mmm. También te daré una Poké\n"
	.string "Ball. ¡Adelante!\p"
	.string "¡Blasco ha recibido una Poké Ball!$"

PetalburgCity_Gym_Text_WallyOhWowThankYou:
	.string "BLASCO: ¡Oh, guau!\n"
	.string "¡Gracias!$"

PetalburgCity_Gym_Text_WouldYouReallyComeWithMe:
	.string "{PLAYER}... ¿De verdad vendrías\n"
	.string "conmigo?$"

PetalburgCity_Gym_Text_DadSoDidItWorkOut:
	.string "PAPÁ: Entonces, ¿lo conseguiste?$"

PetalburgCity_Gym_Text_WallyThankYouBye:
	.string "BLASCO: Sí, gracias, lo conseguí.\n"
	.string "Aquí tienes tu Pokémon.\p"
	.string "{PLAYER}, gracias por acompañarme.\p"
	.string "Gracias a vosotros dos he podido\n"
	.string "atrapar mi Pokémon.\p"
	.string "Prometo que lo cuidaré muy bien.\p"
	.string "¡Oh! Mi madre me está esperando,\n"
	.string "¡tengo que irme!\p"
	.string "¡Adiós, {PLAYER}!$"

PetalburgCity_Gym_Text_DadGoCollectBadges:
	.string "PAPÁ: Ahora...\p"
	.string "{PLAYER}, si quieres ser un entrenador\n"
	.string "fuerte, aquí tienes mi consejo.\p"
	.string "Ve a Ciudad Férrica, que está más allá\n"
	.string "de este pueblo.\p"
	.string "Allí deberías desafiar a la líder del\n"
	.string "gimnasio, Petra.\p"
	.string "Después de ella, ve a otros gimnasios\n"
	.string "Pokémon y derrota a sus líderes.\p"
	.string "Consigue sus medallas, ¿entendido?\p"
	.string "Por supuesto, yo también soy líder de\n"
	.string "gimnasio. Algún día lucharemos, {PLAYER}.\p"
	.string "Pero eso será cuando seas más fuerte.$"

PetalburgCity_Gym_Text_NormanGoToRustboro:
	.string "PAPÁ: ¿Mmm? ¿No vas al gimnasio Pokémon\n"
	.string "de Ciudad Férrica?\p"
	.string "No tiene sentido que luche contra un\n"
	.string "entrenador novato.\p"
	.string "{PLAYER}, quiero que me desafíes cuando\n"
	.string "seas mucho más fuerte.\p"
	.string "Te lucharé, {PLAYER}, cuando puedas\n"
	.string "mostrarme cuatro medallas de gimnasio, ¿vale?$"

PetalburgCity_Gym_Text_NormanGoToDewford:
	.string "PAPÁ: Ya veo... Así que has derrotado\n"
	.string "a la líder del gimnasio de Ciudad Férrica.\p"
	.string "Pero hay muchos más entrenadores que son\n"
	.string "más fuertes que tú, {PLAYER}.\p"
	.string "Al otro lado del mar, en Pueblo Azuliza,\n"
	.string "hay un líder de gimnasio llamado Marc.\p"
	.string "Deberías ir a desafiarlo.$"

PetalburgCity_Gym_Text_YouHaveGottenStronger:
	.string "PAPÁ: Mmm... {PLAYER}, te has vuelto\n"
	.string "más fuerte.\p"
	.string "Me doy cuenta por el número de medallas\n"
	.string "que has conseguido.$"

PetalburgCity_Gym_Text_NormanIntro:
	.string "PAPÁ: Mmm...\n"
	.string "Así que has conseguido cuatro medallas.\p"
	.string "Estupendo, como te prometí, tendremos\n"
	.string "un combate Pokémon.\p"
	.string "{PLAYER}...\p"
	.string "Estoy tan orgulloso de poder enfrentarme\n"
	.string "a ti... ¡Pero un combate es un combate!\p"
	.string "Haré todo lo que pueda como líder de\n"
	.string "gimnasio para ganar.\p"
	.string "{PLAYER}, será mejor que tú también des\n"
	.string "lo mejor de ti.$"

PetalburgCity_Gym_Text_NormanDefeat:
	.string "...\p"
	.string "Yo... Yo no puedo...\p"
	.string "No puedo creérmelo. {PLAYER}...\p"
	.string "¿He perdido contra {PLAYER}?\p"
	.string "Pero las reglas son las reglas.\n"
	.string "Aquí tienes.$"

PetalburgCity_Gym_Text_ReceivedBalanceBadge:
	.string "¡{PLAYER} ha recibido la Medalla\n"
	.string "Equilibrio de Papá!$"

PetalburgCity_Gym_Text_ExplainBalanceBadgeTakeThis:
	.string "PAPÁ: Con esa medalla, la Defensa de\n"
	.string "todos tus Pokémon aumentará.\p"
	.string "Los Pokémon que conozcan el movimiento\n"
	.string "MO Surf podrán viajar sobre el agua.\p"
	.string "Este es mi regalo para ti. {PLAYER}, estoy\n"
	.string "seguro de que sabrás usarlo correctamente.$"

PetalburgCity_Gym_Text_ExplainFacade:
	.string "PAPÁ: La MT42 contiene Imagen.\p"
	.string "Duplica la potencia de los movimientos si\n"
	.string "el Pokémon está envenenado, paralizado o\n"
	.string "quemado.\p"
	.string "Puede sacar ventaja de una situación\n"
	.string "poco favorable.$"

PetalburgCity_Gym_Text_DadHappyAndSad:
	.string "PAPÁ: Como líder de gimnasio, no me\n"
	.string "imaginas lo triste que estoy...\p"
	.string "Pero como padre, me hace feliz y un poco\n"
	.string "triste al mismo tiempo. Es extraño...$"

PetalburgCity_Gym_Text_PleaseComeWithMe:
	.string "Ah, aquí estás, {PLAYER}{KUN}.\p"
	.string "Por favor, ven conmigo.\n"
	.string "Tengo algo que quiero darte.$"

PetalburgCity_Gym_Text_LetMeBorrowPlayer:
	.string "Norman, no te importa, ¿verdad?\p"
	.string "Déjame llevarte a {PLAYER}{KUN} un\n"
	.string "minuto o dos.$"

PetalburgCity_Gym_Text_DadGoingToKeepTraining:
	.string "PAPÁ: {PLAYER}, deberías ir a visitar a\n"
	.string "tu madre de vez en cuando.\p"
	.string "Yo me quedaré aquí y redoblaré mi\n"
	.string "entrenamiento.\p"
	.string "Me molestaría como entrenador no tomar\n"
	.string "mi revancha contra ti, {PLAYER}.$"

PetalburgCity_Gym_Text_DadNoAmountOfTrainingIsEnough:
	.string "PAPÁ: {PLAYER}, ¿cómo te va?\p"
	.string "El mundo de los Pokémon es profundo.\p"
	.string "Honestamente creo que no hay entrenamiento\n"
	.string "que sea suficiente.$"

PetalburgCity_Gym_Text_GymGuideAdvice:
	.string "¡Eh, qué tal, futuro campeón {PLAYER}?\p"
	.string "Las puertas de este gimnasio se abren\n"
	.string "cuando derrotas a los entrenadores que te\l"
	.string "esperan.\p"
	.string "¡Ups! Las puertas de esta sala ya están\n"
	.string "abiertas, así que no me ataques.\p"
	.string "Los entrenadores del Gimnasio Petalia\n"
	.string "usan todo tipo de objetos.\p"
	.string "La puerta de la izquierda lleva a la\n"
	.string "Sala de Velocidad.\p"
	.string "La puerta de la derecha lleva a la\n"
	.string "Sala de Precisión.\p"
	.string "El nombre de la sala estará en la puerta,\n"
	.string "así que elige con cuidado.\p"
	.string "Una vez que elijas la puerta...\n"
	.string "Bueno, ¡adelante!$"

PetalburgCity_Gym_Text_GymGuidePostVictory:
	.string "¡{PLAYER}! ¡Guau! ¡Has superado incluso\n"
	.string "a tu propio padre!\p"
	.string "¡Vaya, vaya!\n"
	.string "¡Qué giro de los acontecimientos!$"

PetalburgCity_Gym_Text_RandallIntro:
	.string "La capacidad de atacar antes que tu\n"
	.string "oponente. Solo eso constituye una gran\l"
	.string "ventaja, ¿no crees?$"

PetalburgCity_Gym_Text_RandallDefeat:
	.string "¡Ha sido un gran combate!$"

PetalburgCity_Gym_Text_RandallPostBattle:
	.string "Ve a la siguiente sala, donde te aguarda\n"
	.string "un nuevo desafío.\p"
	.string "A la izquierda está la Sala de Confusión.\p"
	.string "La puerta de la derecha lleva a la Sala\n"
	.string "de Defensa.$"

PetalburgCity_Gym_Text_RandallPostBadge:
	.string "A quien venzas, y a quien pierdas, nunca\n"
	.string "te apartas del entrenamiento de ti mismo\l"
	.string "y de tus Pokémon.\p"
	.string "Eso es lo que creo que significa ser un\n"
	.string "líder de gimnasio.$"

PetalburgCity_Gym_Text_ParkerIntro:
	.string "Esta es la Sala de Confusión.\p"
	.string "¡Déjame ver lo bien que te llevas con\n"
	.string "tus Pokémon!$"

PetalburgCity_Gym_Text_ParkerDefeat:
	.string "No hay quien confunda a tu equipo...\n"
	.string "Se nota que estáis unidos a tope.$"

PetalburgCity_Gym_Text_ParkerPostBattle:
	.string "La siguiente sala es la Sala de Fuerza.\n"
	.string "¿Resistirás un combate a la máxima\l"
	.string "potencia?$"

PetalburgCity_Gym_Text_ParkerPostBadge:
	.string "Después de que derrotaste a nuestro líder,\n"
	.string "el entrenamiento se ha vuelto mucho más\l"
	.string "duro.$"

PetalburgCity_Gym_Text_GeorgeIntro:
	.string "Justo cuando piensas que vas a ganar, tu\n"
	.string "rival restaura PS...\p"
	.string "¿Tienes idea de lo mal que sienta una\n"
	.string "cosa así?\p"
	.string "¡Pues ahora mismo lo vas a comprobar!$"

PetalburgCity_Gym_Text_GeorgeDefeat:
	.string "No conseguí restaurar suficientes PS...\n"
	.string "Vaya potencia de ataque...$"

PetalburgCity_Gym_Text_GeorgePostBattle:
	.string "No debería haber esperado menos del hijo\n"
	.string "del líder.\p"
	.string "No, espera. Las habilidades de un\n"
	.string "entrenador se ganan solo con esfuerzo.\p"
	.string "He perdido porque mi propio esfuerzo no\n"
	.string "ha sido suficiente.\p"
	.string "¡Adelante! La Sala del K.O. Instantáneo\n"
	.string "es la siguiente.$"

PetalburgCity_Gym_Text_GeorgePostBadge:
	.string "Voy a seguir entrenando en gimnasios.\n"
	.string "Algún día, seré un líder.$"

PetalburgCity_Gym_Text_BerkeIntro:
	.string "No voy a ponértelo fácil porque seas hijo\n"
	.string "de nuestro líder.\p"
	.string "Te voy a enseñar lo mal que sienta\n"
	.string "recibir un golpe crítico!$"

PetalburgCity_Gym_Text_BerkeDefeat:
	.string "Qué fuerza...\n"
	.string "Eres el no va más.$"

PetalburgCity_Gym_Text_BerkePostBattle:
	.string "Tu padre es muy fuerte. Es un entrenador\n"
	.string "muy respetado.\p"
	.string "Y tengo la impresión de que llegarás tan\n"
	.string "lejos como él.\p"
	.string "¡Espero que ambos entabléis un gran\n"
	.string "combate!$"

PetalburgCity_Gym_Text_BerkePostBadge:
	.string "Desde que tu padre se convirtió en líder,\n"
	.string "los entrenadores de Ciudad Petalia se han\l"
	.string "vuelto mucho más duros.$"

PetalburgCity_Gym_Text_MaryIntro:
	.string "Ji, ji, ji...\n"
	.string "Esta es la Sala de Precisión.\p"
	.string "Es bastante desagradable cuando cada\n"
	.string "ataque acierta sin fallar.$"

PetalburgCity_Gym_Text_MaryDefeat:
	.string "Eres muy superior a mí...$"

PetalburgCity_Gym_Text_MaryPostBattle:
	.string "Hay entrenadores aún más fuertes\n"
	.string "esperándote.\p"
	.string "A la izquierda está la Sala de Defensa, y\n"
	.string "a la derecha la Sala de Recuperación.\p"
	.string "El poder de ataque de tus Pokémon estará\n"
	.string "a prueba de cualquier manera.$"

PetalburgCity_Gym_Text_MaryPostBadge:
	.string "¿Sabes qué estamos intentando conseguir\n"
	.string "como entrenadores?\p"
	.string "Estamos luchando por convertirnos en\n"
	.string "almas gemelas con nuestros Pokémon.$"

PetalburgCity_Gym_Text_AlexiaIntro:
	.string "Cuanto más alta es la defensa, más\n"
	.string "implacable puedo ser en el ataque.$"

PetalburgCity_Gym_Text_AlexiaDefeat:
	.string "Nuestras defensas no han sido suficientes...$"

PetalburgCity_Gym_Text_AlexiaPostBattle:
	.string "Creo que me has enseñado una valiosa\n"
	.string "lección aquí.\p"
	.string "Ahora, ¡sigue adelante! La puerta de la\n"
	.string "izquierda lleva a la Sala de Fuerza.\p"
	.string "La puerta de la derecha lleva a la Sala\n"
	.string "del K.O. Instantáneo.\p"
	.string "Ambos tienen entrenadores que son\n"
	.string "habilidosos en el ataque.$"

PetalburgCity_Gym_Text_AlexiaPostBadge:
	.string "¡Hola! ¿Has probado a usar Surf?$"

PetalburgCity_Gym_Text_JodyIntro:
	.string "Nuestro líder de gimnasio nos dijo que\n"
	.string "fuéramos a por todas y te derrotáramos.\p"
	.string "¡Incluso si resulta ser el hijo del líder!$"

PetalburgCity_Gym_Text_JodyDefeat:
	.string "Pero... ¡fui a por todas!$"

PetalburgCity_Gym_Text_JodyPostBattle:
	.string "La forma en que usas tus Pokémon...\n"
	.string "Es como el estilo de tu padre.\p"
	.string "¡Sigue adelante! ¡El líder de gimnasio,\n"
	.string "tu padre, te espera!$"

PetalburgCity_Gym_Text_JodyPostBadge:
	.string "Claro, está bien hacer que tus Pokémon\n"
	.string "sean más fuertes.\p"
	.string "Pero ¿qué decide al ganador?\p"
	.string "Son los sentimientos que los entrenadores\n"
	.string "tienen por sus Pokémon.$"

PetalburgCity_Gym_Text_DoorAppearsLocked:
	.string "Esta puerta parece estar cerrada\n"
	.string "ahora mismo...$"

PetalburgCity_Gym_Text_EnterSpeedRoom:
	.string "“Sala de Velocidad”, dice el cartel.\p"
	.string "¿Quieres entrar?$"

@ Unused
PetalburgCity_Gym_Text_DoorAppearsLocked2:
	.string "Esta puerta parece estar cerrada\n"
	.string "ahora mismo...$"

PetalburgCity_Gym_Text_EnterAccuracyRoom:
	.string "“Sala de Precisión”, dice el cartel.\p"
	.string "¿Quieres entrar?$"

PetalburgCity_Gym_Text_EnterConfusionRoom:
	.string "“Sala de Confusión”, dice el cartel.\p"
	.string "¿Quieres entrar?$"

PetalburgCity_Gym_Text_EnterDefenseRoom:
	.string "“Sala de Defensa”, dice el cartel.\p"
	.string "¿Quieres entrar?$"

PetalburgCity_Gym_Text_EnterRecoveryRoom:
	.string "“Sala de Recuperación”, dice el cartel.\p"
	.string "¿Quieres entrar?$"

PetalburgCity_Gym_Text_EnterStrengthRoom:
	.string "“Sala de Fuerza”, dice el cartel.\p"
	.string "¿Quieres entrar?$"

PetalburgCity_Gym_Text_EnterOHKORoom:
	.string "“Sala del K.O. Instantáneo”, dice el\n"
	.string "cartel.\p"
	.string "¿Quieres entrar?$"

PetalburgCity_Gym_Text_EnterGymLeadersRoom:
	.string "“Sala del Líder de Gimnasio\p"
	.string "“¡Descubre qué Pokémon te esperan!”\n"
	.string "dice el cartel.\p"
	.string "¿Quieres entrar?$"

PetalburgCity_Gym_Text_GymStatue:
	.string "Gimnasio Pokémon de Ciudad Petalia$"

PetalburgCity_Gym_Text_GymStatueCertified:
	.string "Gimnasio Pokémon de Ciudad Petalia\p"
	.string "Entrenadores certificados por Norman:\n"
	.string "{PLAYER}$"

PetalburgCity_Gym_Text_NormanPreRematch:
	.string "PAPÁ: {PLAYER}...\n"
	.string "Ya sabía yo que ibas a venir.\p"
	.string "Yo nunca me negaría a aceptar\n"
	.string "un desafío de tu parte.\p"
	.string "Sabes a qué me refiero, ¿verdad?\p"
	.string "Dentro de un gimnasio, no importa que\n"
	.string "seamos padre e hijo.\p"
	.string "...No, precisamente porque somos padre\n"
	.string "e hijo, nos debemos el uno al otro dar\l"
	.string "lo mejor de nosotros. ¿No es así, {PLAYER}?$"

PetalburgCity_Gym_Text_NormanRematchDefeat:
	.string "Eh... Ja, ja, ja...\n"
	.string "Está claro que no te has andado con\l"
	.string "chiquitas...$"

PetalburgCity_Gym_Text_NormanPostRematch:
	.string "PAPÁ: {PLAYER}...\n"
	.string "¿Cuál es tu sueño?\p"
	.string "Mi sueño...\n"
	.string "Ja, ja, ja...\l"
	.string "En realidad, ya se ha hecho realidad.$"

PetalburgCity_Gym_Text_NormanRematchNeedTwoMons:
	.string "PAPÁ: {PLAYER}...\n"
	.string "Ya sabía yo que ibas a venir.\p"
	.string "Yo nunca me negaría a aceptar\n"
	.string "un desafío de tu parte.\p"
	.string "Sabes a qué me refiero, ¿verdad?\p"
	.string "Dentro de un gimnasio, no importa que\n"
	.string "seamos padre e hijo.\p"
	.string "¿Mmm? Espera un momento, {PLAYER}.\p"
	.string "¿Solo tienes un Pokémon capaz de\n"
	.string "combatir?\p"
	.string "Lo siento, pero tendrás que volver con\n"
	.string "al menos dos Pokémon.$"

