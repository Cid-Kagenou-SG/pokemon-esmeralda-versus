Route103_Text_LivPostBattle:
	.string "MAR: Mi hermana mayor y yo trabajamos\n"
	.string "perfectamente bien en equipo.\l"
	.string "Pero esta vez no ha ido tan bien...$"

Route103_Text_AmyLivRegister:
